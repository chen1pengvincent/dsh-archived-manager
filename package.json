{
  "name": "dsh-archived-manager",
  "version": "0.4.4",
  "description": "DSH (DeepSeek Harness) 会话归档与回收站清理插件：搜索/筛选/排序已归档会话、还原到侧边栏、移入最近删除（回收站）、彻底删除并连带清理关联 .ACP.sqlite 上下文库与附件、检测宿主文件占用并支持重启自动清理。Manage archived sessions with native unarchive, recoverable Recently Deleted trash, permanent purge, companion ACP database/attachment cleanup, file-lock diagnostics, and scheduled retention.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib/",
    "client/",
    "locale/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "chen1pengvincent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen1pengvincent/dsh-archived-manager.git"
  },
  "homepage": "https://github.com/chen1pengvincent/dsh-archived-manager#readme",
  "bugs": {
    "url": "https://github.com/chen1pengvincent/dsh-archived-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "archived-sessions",
    "session-management",
    "session-manager",
    "session-cleanup",
    "session-archive",
    "recently-deleted",
    "trash",
    "recycle-bin",
    "quarantine",
    "purge",
    "disk-cleanup",
    "retention",
    "file-lock",
    "acp-sqlite",
    "desktop",
    "会话管理",
    "归档管理",
    "已归档会话",
    "回收站",
    "最近删除",
    "彻底删除",
    "磁盘清理",
    "文件占用"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
